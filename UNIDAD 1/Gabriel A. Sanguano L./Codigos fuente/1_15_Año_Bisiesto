#include <stdio.h>

int main() {
    int anio;

    printf("Ingrese un ano: ");
    scanf("%d", &anio);

    if ((anio % 4 == 0 && anio % 100 != 0) || (anio % 400 == 0)) {
        printf("%d es un anio bisiesto\n", anio);
    } else {
        printf("%d No es un anio bisiesto\n", anio);
    }

    return 0;
}
