#include <stdio.h>

int main() {
    float num1, num2, media;

    printf("Ingrese el primer numero: ");
    scanf("%f", &num1);
    printf("Ingrese el segundo numero: ");
    scanf("%f", &num2);

    if (num1 == -num2 || -num1 == num2) {
        printf("operacion no valida\n");
    } else {
        media = (num1 + num2) / 2.0;
        printf("la media es: %f\n", media);
    }

    return 0;
}
