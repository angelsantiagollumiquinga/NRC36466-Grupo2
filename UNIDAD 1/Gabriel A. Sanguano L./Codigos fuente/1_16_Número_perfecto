#include <stdio.h>

int main() {
    int n, sumaDiv = 0;

    printf("Ingrese un entero positivo: ");
    scanf("%d", &n);

    for (int d = 1; d <= n - 1; d++) {
        if (n % d == 0) {
            sumaDiv = sumaDiv + d;
        }
    }

    if (sumaDiv == n) {
        printf("%d es un numero perfecto\n", n);
    } else {
        printf("%d No es un numero perfecto\n", n);
    }

    return 0;
}
