#include <stdio.h>

int main() {
    int n, esprimo = 1;

    printf("Ingrese un entero mayor que 1: ");
    scanf("%d", &n);

    for (int i = 2; i <= n - 1; i++) {
        if (n % i == 0) {
            esprimo = 0;
            break;
        }
    }

    if (esprimo && n > 1) {
        printf("%d es un numero primo\n", n);
    } else {
        printf("%d no es un numero primo\n", n);
    }

    return 0;
}
